      "id": "31352541-58f6-471e-a762-931274243869",
      "name": "NumLookup Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2704,
        2880
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json;\n\nconst lineType = String(lead?.line_type || 'unknown').toLowerCase();\n\nlet lineCategory = 'unknown';\nlet canSMS = false;\n\nif (lineType === 'mobile') {\n  lineCategory = 'mobile';\n  canSMS = true;\n} else if (lineType === 'landline') {\n  lineCategory = 'landline';\n} else if (lineType === 'voip' || lineType === 'nonfixedvoip') {\n  lineCategory = 'voip';\n}\n\nlet priority = 'normal';\nif (lineType === 'mobile') priority = 'high';\nif (lineType === 'unknown') priority = 'low';\n\nlet score = 0;\nif (Number(lead.rating) >= 4) score += 2;\nif (Number(lead.reviews) > 50) score += 2;\nif (lead.website) score += 1;\nif (lead.email) score += 1;\nif (lineType === 'mobile') score += 2;\n\nreturn {\n  json: {\n    ...lead,\n    line_type: lineType,\n    line_category: lineCategory,\n    can_sms: canSMS ? 'YES' : 'NO',\n    priority,\n    lead_score: score,\n    call_status: 'not_called',\n    notes: '',\n    enriched_at: new Date().toISOString()\n  }\n};"
      },
      "id": "eaec25e9-ae49-4e5c-b9c9-007d3d68f508",
      "name": "Enrich Lead",
