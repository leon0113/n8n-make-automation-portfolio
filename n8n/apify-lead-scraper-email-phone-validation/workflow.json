      "id": "73f8d739-4507-4c51-be0b-c656ce0c9d07",
      "name": "Has Website?",
      "type": "n8n-nodes-base.if",
      "position": [
        1456,
        2880
      ],
      "typeVersion": 2,
      "notes": "Only attempt website scrape if a website URL exists. Saves time and avoids errors on businesses with no website."
    },
    {
      "parameters": {
        "url": "={{ $json.website }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 3
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 8000
        }
