        "jsCode": "const results = [];\n\nfor(const item of items){\n  const origwidth = item.json.size.width;\n  const origheight = item.json.size.height;\n\n  const bgHeight = origheight;\n  const bgWidth = Math.round((16/9)*bgHeight);\n\n  const positionX = Math.round((bgWidth - origwidth) / 2);\n  const positionY = 0;\n\n  results.push({\n    json: {\n      backgroundWidth: bgWidth,\n      backgroundHeight: bgHeight,\n      positionX,\n      positionY\n    }\n  })\n}\n\nreturn results"
      },
