      "parameters": {
        "jsCode": "const results = [];\n\n// Loop over all input items\nfor (const item of $input.all()) {\n  \n  // 1. Get the data. If 'json' is an array (which causes the error), take the first item.\n  let data = Array.isArray(item.json) ? item.json[0] : item.json;\n\n  // 2. Extract and Clean the text\n  let cleanText = \"\";\n  \n  // Check if the Anthropic/Claude structure exists\n  if (data.content && data.content[0] && data.content[0].text) {\n    const rawText = data.content[0].text;\n    cleanText = rawText.replace(/[\\r\\n]+/g, ' ').trim();\n  } \n  // Fallback: If the text is just in a 'text' property\n  else if (data.text) {\n    cleanText = data.text.replace(/[\\r\\n]+/g, ' ').trim();\n  }\n\n  // 3. Add the clean prompt to the data object\n  data.videoPrompt = cleanText;\n\n  // 4. Push to results in the strictly correct n8n format\n  results.push({\n    json: data,\n    binary: item.binary // Keep any binary files (images) attached\n  });\n}\n\nreturn results;"
      },
