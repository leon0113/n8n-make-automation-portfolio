    {
      "parameters": {
        "jsCode": "// Parse GPT output into structured carousel data\nconst raw = $input.first().json.message?.content ?? $input.first().json.content ?? '';\n\nlet parsed = {};\n\n// Try direct JSON parse\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // Fallback: extract first JSON block\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try {\n      parsed = JSON.parse(match[0]);\n    } catch (e2) {\n      throw new Error('Failed to parse GPT JSON output: ' + raw.slice(0, 200));\n    }\n  }\n}\n\nif (!parsed.slides || !Array.isArray(parsed.slides)) {\n  throw new Error('No slides array found in GPT output');\n}\n\n// Normalize hashtags\nconst hashtagsArray = Array.isArray(parsed.hashtags)\n  ? parsed.hashtags.map(h => String(h).trim()).filter(Boolean)\n  : [];\n\nconst hashtagsString = hashtagsArray.join(' ');\n\n// Normalize SEO keywords\nconst seoArray = Array.isArray(parsed.seo_keywords)\n  ? parsed.seo_keywords.map(k => String(k).trim()).filter(Boolean)\n  : [];\n\nreturn [{\n  json: {\n    carousel_title: String(parsed.carousel_title || '').trim(),\n    caption: String(parsed.caption || '').trim(),\n    hashtags: hashtagsString,\n    hashtags_array: hashtagsArray,\n    seo_keywords: seoArray.join(', '),\n    slides: parsed.slides,\n    slide_count: parsed.slides.length,\n    topic: $('Limit: 1 Topic at a Time').item.json.Topic\n  }\n}];"
      },
