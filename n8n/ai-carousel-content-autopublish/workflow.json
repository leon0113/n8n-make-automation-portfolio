    {
      "parameters": {
        "jsCode": "// Build final mediaUrls array from all collected slide URLs\nconst allItems = $input.first().json.data;\n\n// Sort by slide number to ensure correct order\nallItems.sort((a, b) => a.slide_number - b.slide_number);\n\nconst mediaUrls = allItems.map(item => item.blotato_url).filter(Boolean);\n\n// Get metadata from first slide (shared across all)\nconst meta = allItems[0];\n\nreturn [{\n  json: {\n    media_urls: mediaUrls,\n    media_urls_json: JSON.stringify(mediaUrls),\n    carousel_title: meta.carousel_title,\n    caption: meta.caption,\n    hashtags: meta.hashtags,\n    seo_keywords: meta.seo_keywords,\n    topic: meta.topic,\n    slide_count: mediaUrls.length\n  }\n}];"
      },
