    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a YouTube SEO metadata generator for the Northwind Digital Solutions Inc. social media channel.\nBased on the following SCRIPT text:\n{{ $('Script Writer').item.json.message.content }}\nFollow these STRICT RULES:\nOutput only JSON with fields exactly: title_final, caption, hashtags.\nDo NOT add extra text, comments, or code blocks.\ntitle_final: ≤ 80 chars, must include at least one exact phrase from the first sentence of the SCRIPT.\ncaption: ≤ 300 chars (before fixed text), start with a hook that reuses phrasing from the SCRIPT (no hashtags).\nAfter this generated caption, always append the following fixed block in the same line, separated with \" | \" instead of new lines:\nWant to automate your business? Subscribe: https://www.youtube.com/@northwinddigital?sub_confirmation=1 | Follow on Facebook: https://www.facebook.com/northwinddigital | Follow on Instagram: https://www.instagram.com/northwinddigital/ | Disclaimer: General info only, not financial or legal advice.\nhashtags: 3–5 items, all lower case, no spaces, all must be terms already present in SCRIPT (or their exact tokenized form with #).\nAlways include #NorthwindnNetworks and #AIAutomation in hashtags.\nHashtags should appear inside the caption at the end, before the fixed block.",
              "role": "system"
            },
            {
              "content": "Title: Home Buying Tips\\nWrite JSON with keys: title_final (<=80 chars), caption (<=300 chars), hashtags (6-10 items).\\n\\nExample JSON:\\n{\\n  \"title_final\": \"5 Tips for Buying a Home in your area\",\\n  \"caption\": \"Thinking of buying your first home in your area? Here are 5 tips to help you get started! #realestate #firsttimehomebuyer #realestatetips\",\\n  \"hashtags\": [\"#realestate\", \"#firsttimehomebuyer\", \"#realestatetips\", \"#homeowners\", \"#realestate\"]\\n}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -1360,
        160
      ],
      "id": "ba130086-0b86-4234-babe-3eeafc9d0ee0",
      "name": "Caption AI",
      "credentials": {
        "openAiApi": {
          "id": "{{CREDENTIAL_ID}}",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse JSON block from model output → { title_final, caption, hashtags }\nconst raw = $json.message?.content ?? $json.content ?? '';\nconst m = raw.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/i);\nconst body = m ? m[1] : raw;\nlet obj;\ntry { obj = JSON.parse(body); } catch { obj = { title_final: raw.slice(0,80), caption: raw.slice(0,300), hashtags: [] }; }\nconst title_final = String(obj.title_final || '').trim();\nconst caption = String(obj.caption || '').trim();\nlet hashtags = Array.isArray(obj.hashtags) ? obj.hashtags : [];\nhashtags = hashtags.map(h => h.trim()).filter(Boolean);\nreturn [{ json: { title_final, caption } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1008,
        160
      ],
