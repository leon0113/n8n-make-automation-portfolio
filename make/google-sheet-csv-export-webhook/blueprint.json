{
  "name": "Google Sheet to CSV Download Webhook",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "{{HOOK_ID}}",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:getSheetContent",
      "version": 2,
      "parameters": {
        "__IMTCONN__": "{{GOOGLE_SHEETS_CONNECTION_ID}}"
      },
      "mapper": {
        "from": "drive",
        "range": "A1:E50",
        "select": "list",
        "sheetId": "Sheet1",
        "spreadsheetId": "/{{SHEET_ID}}",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "csv:CreateAdvancedAggregator",
      "version": 1,
      "parameters": {
        "type": "{{DATA_STRUCTURE_ID}}",
        "feeder": 5,
        "delimiter": ",",
        "newlineType": "LF",
        "delimiterType": "other",
        "includeHeaders": true
      },
      "mapper": {
        "Name": "",
        "Email": "",
        "Phone": "",
        "Address": "",
        "GoogleSheetCSVStructure": ""
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "body": "CSV → Data",
        "status": "200",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"SheetExport.csv\"\n​"
          },
          {
            "key": "Content-Type",
            "value": "text/csv"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com",
    "notes": []
  }
}
